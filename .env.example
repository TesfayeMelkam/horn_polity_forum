# Copy this file to ".env" (same folder). Fill in only what you use, then restart the app.

# --- Ethiopia: online checkout (Telebirr, CBE Birr, banks, cards) via Chapa - https://chapa.co
CHAPA_SECRET_KEY=

# --- Visa / Mastercard cards AND Alipay (via Stripe Checkout) - https://stripe.com  (account availability depends on your country)
STRIPE_SECRET_KEY=

# --- PayPal (USD / EUR) - https://developer.paypal.com  (use sandbox keys first)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# change to "live" only when you use your live PayPal keys

# Your public https address once the site is online (needed for payment return/callback URLs). Leave empty on localhost.
HPF_PUBLIC_URL=

# Admin password used the FIRST time the database is created (change it later in Admin > Settings)
HPF_ADMIN_PASSWORD=
